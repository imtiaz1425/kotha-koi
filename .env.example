# ==============================================================================
# KothaKoi – Root Environment Template
# Copy this file to backend/.env and fill in the required values.
# NEVER commit .env to version control.
# ==============================================================================

# --- Backend Server Configuration ---
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
TRUST_PROXY=false

# --- Session & Security ---
# Minimum 16 characters required. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_a_long_unpredictable_secret_min_16_chars

# Minimum 16 characters required for HMAC hashing of OTP codes
OTP_HMAC_SECRET=replace_with_a_secret_key_for_otp_hmac_min_16_chars

# --- Database (PostgreSQL & Prisma) ---
DATABASE_URL=postgresql://kothakoi:kothakoi_dev_password@localhost:5432/kothakoi?schema=public

# --- Authentication & Student Eligibility ---
ALLOWED_EMAIL_DOMAINS=uiu.ac.bd,bscse.uiu.ac.bd

# --- WebRTC TURN Configuration (Metered Open Relay) ---
# Metered app name (subdomain without .metered.live)
METERED_APP_NAME=your_metered_app_name
# Metered secret API key (keep server-side only; never expose to client)
METERED_API_KEY=your_metered_api_key_here
