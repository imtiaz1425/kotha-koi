# =============================================================
# KothaKoi – Environment Variables Template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================

# --- Backend ---
# A long, random, unpredictable string used to sign session cookies (min 16 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string_min_16_chars

# Port the backend HTTP server listens on.
PORT=5000

# Application environment: "development", "test", or "production"
NODE_ENV=development

# Allowed origin for CORS (frontend URL).
CLIENT_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL) ---
# Connection string for PostgreSQL database (matches docker-compose.yml dev defaults).
DATABASE_URL=postgresql://kothakoi:kothakoi_dev_password@localhost:5432/kothakoi?schema=public

# --- Authentication & Student Eligibility ---
# Comma-separated list of allowed email domains for student verification.
ALLOWED_EMAIL_DOMAINS=uiu.ac.bd,bscse.uiu.ac.bd

# Secret key used for HMAC hashing of 6-digit login OTP codes (min 16 chars).
# Optional in dev (defaults apply if unset), required in production.
OTP_HMAC_SECRET=replace_with_a_secret_key_for_otp_hmac_min_16_chars

# --- Reverse Proxy Configuration ---
# Express trust proxy configuration. Must be configured deliberately for production reverse proxies.
# Safe default is "false" (direct connection). Supported: "false", "true", integer hop count (e.g. "1"), "loopback", or CIDR.
TRUST_PROXY=false

# --- WebRTC TURN Configuration (Metered Open Relay) ---
# Metered app name (subdomain without .metered.live)
METERED_APP_NAME=kothakoi
# Metered secret API key (keep server-side only; never expose to client)
METERED_API_KEY=your_metered_api_key_here


