# =============================================================
# KothaKoi – Environment Variables Template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================

# --- Backend ---
# A long, random, unpredictable string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# Port the backend HTTP server listens on.
PORT=5000

# Application environment: "development" or "production"
NODE_ENV=development

# Allowed origin for CORS (frontend URL).
CLIENT_ORIGIN=http://localhost:3000

# --- Database (reserved – not used yet) ---
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/kothakoi
