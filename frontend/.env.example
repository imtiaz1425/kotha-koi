# ==============================================================================
# KothaKoi Frontend Environment Variables
# Copy this file to frontend/.env (optional in local development).
# In local development, Vite proxies /api and /socket.io directly to http://localhost:5000.
# ==============================================================================

# Optional port override for Vite development server (default: 3000)
# PORT=3000

# Optional backend API URL override if hosting the frontend on a separate domain in production
# Default in development: relative "/api" (handled by Vite dev proxy)
# VITE_API_URL=http://localhost:5000/api

# Optional Socket.IO URL override if hosting the frontend on a separate domain in production
# Default in development: relative "/" with path "/socket.io" (handled by Vite dev proxy)
# VITE_SOCKET_URL=http://localhost:5000
