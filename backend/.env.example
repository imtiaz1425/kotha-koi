# ==============================================================================
# KothaKoi Backend Environment Variables
# Copy this file to backend/.env and fill in the placeholders.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# --- Server Configuration ---
# HTTP Port for Express server (default: 5000)
PORT=5000

# Node execution environment: "development", "test", or "production"
NODE_ENV=development

# Allowed origin for CORS and cookie credentials (typically frontend URL)
CLIENT_ORIGIN=http://localhost:3000

# Express reverse proxy trust setting:
# Use "false" (default) for direct local connections.
# In production behind Nginx/Cloudflare, set to "true", integer hop count (e.g. 1), or specific CIDRs.
TRUST_PROXY=false

# --- Session & Security ---
# Secret key used to sign and verify HttpOnly session cookies (minimum 16 characters required).
# Generate a strong key with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_a_long_unpredictable_secret_min_16_chars

# Secret key used for HMAC hashing of 6-digit login OTP codes (minimum 16 characters required).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_HMAC_SECRET=replace_with_a_secret_key_for_otp_hmac_min_16_chars

# --- Database (PostgreSQL & Prisma) ---
# Connection string for PostgreSQL database.
# Default format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL=postgresql://kothakoi:kothakoi_dev_password@localhost:5432/kothakoi?schema=public

# --- Registration Email Domain Allowlist ---
# Comma-separated list of allowed email domain patterns for account registration
ALLOWED_EMAIL_DOMAINS=uiu.ac.bd,bscse.uiu.ac.bd

# --- WebRTC TURN Relay (Metered Open Relay) ---
# Metered app name / subdomain (the prefix before .metered.live)
METERED_APP_NAME=your_metered_app_name

# Metered secret API key (keep server-side only; never expose to frontend clients)
# Obtain from your Metered Dashboard: https://www.metered.ca/
METERED_API_KEY=your_metered_api_key_here

